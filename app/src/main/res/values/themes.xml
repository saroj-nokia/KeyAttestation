<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Use "Theme" below: values-v29 overrides it to add the navigation bar settings.
         Colors: dynamic color on Android 12+ (DynamicColors in AppApplication); older devices use
         the stock Material 3 palette. values-night swaps the parent for the dark variant. -->
    <style name="Theme" parent="Theme.App.Base" />

    <style name="Theme.App.Base" parent="Theme.Material3Expressive.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Status colors used by the item icons; the cards use the matching container roles
             (see StatusColors.kt). -->
        <item name="colorSafe">?attr/colorPrimary</item>
        <item name="colorWarning">?attr/colorTertiary</item>
        <item name="colorAlert">?attr/colorError</item>
        <item name="colorInactive">?attr/colorOutline</item>
    </style>
</resources>
